# Pro unlock (Google Play Billing one-time purchase). Default off: when not "true" the
# Pro card is hidden, Play Billing is never connected, and ads ignore any cached entitlement.
VITE_ENABLE_PRO=false

# AdMob IDs (default: Google test IDs). Real IDs from the AdMob console for release.
# The Gradle build reads VITE_ADMOB_APP_ID from .env.production / .env (or env ADMOB_APP_ID).
VITE_ADMOB_APP_ID=
VITE_ADMOB_BANNER_ID=
